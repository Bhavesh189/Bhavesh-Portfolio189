
Longest Consecutive Sequence

class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        unordered_set<int> st(nums.begin(), nums.end());
        int ans = 0;

        for(int x : st) {

            if(st.find(x-1) == st.end()) {
                int curr = x;
                int seq = 1;

                while(st.find(curr+1) != st.end()) {
                    curr += 1;
                    seq += 1;
                }

                ans = max(ans, seq);
            }
        }

        return ans;
    }
};